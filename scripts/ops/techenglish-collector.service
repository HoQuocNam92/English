[Unit]
Description=TechEnglish operations metrics and Docker log discovery
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
User=ubuntu
Environment=HOME=/home/ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/techenglish-ops/bin/ops.py collect
TimeoutStartSec=50
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=append:/home/ubuntu/techenglish-ops/state/jobs.log
StandardError=append:/home/ubuntu/techenglish-ops/state/jobs.log
