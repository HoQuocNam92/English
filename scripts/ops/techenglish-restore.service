[Unit]
Description=TechEnglish isolated backup restoration verification
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
User=ubuntu
Environment=HOME=/home/ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/techenglish-ops/bin/backup_s3.py verify
TimeoutStartSec=60min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=append:/home/ubuntu/techenglish-ops/state/jobs.log
StandardError=append:/home/ubuntu/techenglish-ops/state/jobs.log
