{
  "name": "techenglish-pro",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @techenglish/api --filter web run dev",
    "dev:api": "pnpm --filter @techenglish/api dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm run typecheck:packages",
    "typecheck:packages": "pnpm -r --filter \"@techenglish/*\" run typecheck"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/ngrok": "^4.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~58.0.20",
    "react": "19.3.0",
    "react-native": "0.88.0"
  }
}
