{
  "name": "techenglish-pro",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @techenglish/api --filter web run dev",
    "dev:api": "pnpm --filter @techenglish/api dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm run typecheck:packages",
    "typecheck:packages": "pnpm -r --filter \"@techenglish/*\" run typecheck"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/ngrok": "^4.1.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "^5.9.2"
  }
}
