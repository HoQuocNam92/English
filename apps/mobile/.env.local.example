EXPO_PUBLIC_API_URL=https://api.techenglish.click/api/v1
# OAuth client of type Web from the same Google Cloud project as the Android client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Only for iOS builds: use an actual iOS OAuth client, not the Web client.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
