// =============================================================================
// TechEnglish Pro (KLCN028) — Prisma Schema
// Quy ước:
//   - ID: UUID v4 (@db.Uuid)
//   - Timestamps: TIMESTAMPTZ
//   - Table names: snake_case (@@map)
//   - Enum: PascalCase (Prisma) → snake_case (PostgreSQL)
// RBAC: users (auth only) + user_details (profile) + roles + permissions
//       + role_permissions (N:N) + user_roles (N:N, multi-role per user)
// Database tables are managed by Prisma migrations.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  active
  inactive
  suspended

  @@map("user_status")
}

enum ContentStatus {
  draft
  published
  archived

  @@map("content_status")
}

enum LessonType {
  vocabulary
  terminology
  technical_reading
  api_documentation
  system_design
  case_study
  certification_review

  @@map("lesson_type")
}

enum LessonSectionType {
  heading
  rich_text
  image
  audio
  video
  code
  vocabulary_list
  callout
  quiz

  @@map("lesson_section_type")
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
  short_answer
  scenario

  @@map("question_type")
}

enum QuestionSkill {
  vocabulary
  reading
  technical_understanding
  scenario_based

  @@map("question_skill")
}

enum ExamKind {
  practice
  domain_test
  mock_exam
  scenario_assessment

  @@map("exam_kind")
}

enum AttemptStatus {
  in_progress
  submitted
  graded
  expired

  @@map("attempt_status")
}

enum ProgressStatus {
  not_started
  in_progress
  completed

  @@map("progress_status")
}

enum ProgressResourceType {
  lesson
  domain
  certificate

  @@map("progress_resource_type")
}

enum LevelCode {
  beginner
  intermediate
  advanced
  professional

  @@map("level_code")
}

enum VocabStudyStatus {
  new
  learning
  mastered

  @@map("vocab_study_status")
}

// =============================================================================
// AUTH & USERS — Enterprise RBAC
// =============================================================================

/// Tài khoản xác thực. Chỉ chứa thông tin đăng nhập.
/// Thông tin cá nhân → user_details. Phân quyền → user_roles → roles → permissions.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(254)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(active)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Auth relations
  passwordResetTokens PasswordResetToken[]
  refreshTokens RefreshToken[]
  userDetail    UserDetail?
  userRoles     UserRole[]

  // Content & learning
  placementAssessments PlacementAssessment[]
  learnerProfile    LearnerProfile?
  createdExams      Exam[]               @relation("ExamCreatedBy")
  createdLessons    Lesson[]             @relation("LessonCreatedBy")
  examAttempts      ExamAttempt[]
  learnerProgress   LearningProgress[]
  vocabProgress     VocabularyProgress[]
  savedQuestions    SavedQuestion[]
  pushSubscriptions PushSubscription[]
  learningNotifications LearningNotification[]
  ownedLearnerGroups LearnerGroup[]       @relation("LearnerGroupOwner")
  learnerGroupLinks  LearnerGroupMember[] @relation("LearnerGroupMemberUser")

  // Roles granted by this user
  grantedRoles UserRole[] @relation("RoleGrantedBy")

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// Thông tin cá nhân / hồ sơ công khai của user (tất cả vai trò).
/// Bio ở đây là bio chung; learner_profiles.bio là bio học tập riêng.
model UserDetail {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  displayName String    @map("display_name") @db.VarChar(150)
  avatarUrl   String?   @map("avatar_url") @db.VarChar(2048)
  phoneNumber String?   @map("phone_number") @db.VarChar(20)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?   @db.VarChar(20)
  bio         String?   @db.VarChar(500)
  timezone    String?   @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  locale      String?   @default("vi") @db.VarChar(10)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_details")
}

/// Role master — admin, teacher, learner + custom extensible roles.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// System roles cannot be deleted (admin, teacher, learner)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([code])
  @@map("roles")
}

/// Permission master — granular resource:action pairs.
/// Format code: "resource:action" — e.g. "lessons:publish", "users:suspend", "exams:grade"
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// Unique code — format: "resource:action"
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  /// Resource category: users, lessons, exams, vocabulary, questions, reports, recommendations
  resource    String   @db.VarChar(50)
  /// Action: create, read, update, delete, publish, archive, grade, manage
  action      String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([resource, action])
  @@map("permissions")
}

/// N:N — Role ↔ Permission.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// N:N — User ↔ Role. Một user có thể có nhiều role cùng lúc.
model UserRole {
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  grantedById String?   @map("granted_by_id") @db.Uuid

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

/// Refresh token để cấp lại access token (JWT strategy).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// Single-use password reset links. otp_hash retains its legacy name and stores a SHA-256 token hash.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  user      User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  email     String    @db.VarChar(254)
  otpHash   String    @map("otp_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@index([userId])
  @@map("password_reset_tokens")
}

// =============================================================================
// MASTER DATA — Domains, Levels, Certificates
// =============================================================================

/// Lĩnh vực CNTT (Cloud Computing, DevOps, Security, …).
model Domain {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String   @db.VarChar(500)
  icon        String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profileDomains     LearnerProfileDomain[]
  certificateDomains CertificateDomain[]
  vocabularyDomains  VocabularyDomain[]
  vocabularies       Vocabulary[]
  questions          Question[]
  exams              Exam[]
  lessons            Lesson[]

  @@index([code])
  @@index([isActive])
  @@map("domains")
}

/// Cấp độ học tập (Beginner → Professional).
model Level {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(50)
  order       Int
  description String   @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  learnerProfiles LearnerProfile[]
  vocabularies    Vocabulary[]
  questions       Question[]
  exams           Exam[]
  lessons         Lesson[]

  @@map("levels")
}

/// Chứng chỉ CNTT (AWS-SAA, CKA, CompTIA Security+, …).
model Certificate {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(40)
  name                String   @db.VarChar(150)
  provider            String   @db.VarChar(100)
  description         String   @db.VarChar(1000)
  category            String?  @db.VarChar(50)
  examDurationMinutes Int?     @map("exam_duration_minutes")
  examQuestionCount   Int?     @map("exam_question_count")
  passingScaledScore  Int?     @map("passing_scaled_score")
  examUrl             String?  @map("exam_url") @db.VarChar(2048)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  domains      CertificateDomain[]
  profileGoals LearnerCertificateGoal[]
  exams        Exam[]
  lessons      LessonCertificate[]

  @@index([code])
  @@map("certificates")
}

model CareerGoal {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String   @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profileGoals LearnerProfileCareerGoal[]
  learnerGroups LearnerGroup[]

  @@index([isActive])
  @@map("career_goals")
}

/// Bảng nối Certificate ↔ Domain (N:N).
model CertificateDomain {
  certificateId String @map("certificate_id") @db.Uuid
  domainId      String @map("domain_id") @db.Uuid
  order         Int    @default(0)
  weightPercent Float  @default(0) @map("weight_percent")

  certificate         Certificate          @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  domain              Domain               @relation(fields: [domainId], references: [id], onDelete: Cascade)
  certificationTopics CertificationTopic[]

  @@id([certificateId, domainId])
  @@index([certificateId, order])
  @@map("certificate_domains")
}

model CertificationTopic {
  id            String @id @default(uuid()) @db.Uuid
  certificateId String @map("certificate_id") @db.Uuid
  domainId      String @map("domain_id") @db.Uuid
  code          String @db.VarChar(20)
  name          String @db.VarChar(200)
  description   String @db.VarChar(1000)
  order         Int

  certificateDomain CertificateDomain              @relation(fields: [certificateId, domainId], references: [certificateId, domainId], onDelete: Cascade)
  vocabularies      CertificationTopicVocabulary[]
  questions         CertificationTopicQuestion[]
  lessons           CertificationTopicLesson[]

  @@unique([certificateId, code])
  @@unique([certificateId, domainId, order])
  @@index([certificateId, domainId])
  @@map("certification_topics")
}

// =============================================================================
// LEARNER PROFILE & GOALS
// =============================================================================

/// Hồ sơ học viên: trình độ, lĩnh vực, mục tiêu nghề nghiệp & chứng chỉ.
/// bio ở đây là bio học tập riêng, khác với user_details.bio (bio chung).
model LearnerProfile {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @map("user_id") @db.Uuid
  levelId                  String   @map("level_id") @db.Uuid
  bio                      String?  @db.VarChar(500)
  weeklyStudyTargetMinutes Int      @default(180) @map("weekly_study_target_minutes")
  dailyVocabularyTarget    Int      @default(10) @map("daily_vocabulary_target")
  weeklyExamTarget         Int      @default(2) @map("weekly_exam_target")
  dailyStudyTargetMinutes  Int      @default(30) @map("daily_study_target_minutes")
  reminderTime             String?  @map("reminder_time") @db.VarChar(5)
  reminderEnabled          Boolean  @default(false) @map("reminder_enabled")
  learningGoal             String?  @map("learning_goal") @db.VarChar(20)
  learningPathMode         String   @default("smart") @map("learning_path_mode") @db.VarChar(20)
  onboardingCompleted      Boolean  @default(false) @map("onboarding_completed")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id])

  domains   LearnerProfileDomain[]
  certGoals LearnerCertificateGoal[]
  careerGoals LearnerProfileCareerGoal[]

  @@index([levelId])
  @@map("learner_profiles")
}

/// N:N — LearnerProfile ↔ Domain.
model LearnerProfileDomain {
  profileId String @map("profile_id") @db.Uuid
  domainId  String @map("domain_id") @db.Uuid

  profile LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  domain  Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([profileId, domainId])
  @@map("learner_profile_domains")
}

/// Mục tiêu chứng chỉ của học viên.
model LearnerCertificateGoal {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @map("profile_id") @db.Uuid
  certificateId String    @map("certificate_id") @db.Uuid
  targetDate    DateTime? @map("target_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile     LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  certificate Certificate    @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([profileId, certificateId])
  @@map("learner_certificate_goals")
}

model LearnerProfileCareerGoal {
  profileId   String @map("profile_id") @db.Uuid
  careerGoalId String @map("career_goal_id") @db.Uuid

  profile    LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  careerGoal CareerGoal     @relation(fields: [careerGoalId], references: [id], onDelete: Cascade)

  @@id([profileId, careerGoalId])
  @@index([careerGoalId])
  @@map("learner_profile_career_goals")
}

model LearnerGroup {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  description  String?  @db.VarChar(500)
  ownerId      String   @map("owner_id") @db.Uuid
  careerGoalId String?  @map("career_goal_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner      User        @relation("LearnerGroupOwner", fields: [ownerId], references: [id])
  careerGoal CareerGoal? @relation(fields: [careerGoalId], references: [id], onDelete: SetNull)
  members    LearnerGroupMember[]

  @@index([ownerId])
  @@index([careerGoalId])
  @@map("learner_groups")
}

model LearnerGroupMember {
  groupId   String   @map("group_id") @db.Uuid
  learnerId String   @map("learner_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  group   LearnerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  learner User         @relation("LearnerGroupMemberUser", fields: [learnerId], references: [id], onDelete: Cascade)

  @@id([groupId, learnerId])
  @@index([learnerId])
  @@map("learner_group_members")
}

/// Thiết bị/trình duyệt đã cho phép nhận thông báo học tập.
model PushSubscription {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  token        String    @unique @db.Text
  platform     String    @db.VarChar(20)
  active       Boolean   @default(true)
  lastSentDate DateTime? @map("last_sent_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
  @@map("push_subscriptions")
}

// =============================================================================
// CONTENT — Vocabulary
// =============================================================================

/// Từ vựng và thuật ngữ kỹ thuật CNTT chuyên ngành.
model Vocabulary {
  id               String        @id @default(uuid()) @db.Uuid
  term             String        @db.VarChar(150)
  pronunciationIpa String?       @map("pronunciation_ipa") @db.VarChar(100)
  audioUrl         String?       @map("audio_url") @db.VarChar(2048)
  partOfSpeech     String?       @map("part_of_speech") @db.VarChar(50)
  partsOfSpeech    String[]      @default([]) @map("parts_of_speech")
  definitionEn     String        @map("definition_en") @db.VarChar(1000)
  definitionVi     String        @map("definition_vi") @db.VarChar(1000)
  tags             String[]      @default([])
  domainId         String        @map("domain_id") @db.Uuid
  levelId          String        @map("level_id") @db.Uuid
  status           ContentStatus @default(draft)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  domain Domain @relation(fields: [domainId], references: [id])
  level  Level  @relation(fields: [levelId], references: [id])

  domains             VocabularyDomain[]
  examples            VocabularyExample[]
  vocabProgress       VocabularyProgress[]
  certificationTopics CertificationTopicVocabulary[]
  lessons             LessonVocabulary[]

  @@unique([term, domainId])
  @@index([domainId])
  @@index([levelId])
  @@index([status])
  @@map("vocabularies")
}

model VocabularyDomain {
  vocabularyId String @map("vocabulary_id") @db.Uuid
  domainId     String @map("domain_id") @db.Uuid
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  domain       Domain @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@id([vocabularyId, domainId])
  @@index([domainId])
  @@map("vocabulary_domains")
}

model CertificationTopicVocabulary {
  topicId      String @map("topic_id") @db.Uuid
  vocabularyId String @map("vocabulary_id") @db.Uuid

  topic      CertificationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary         @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@id([topicId, vocabularyId])
  @@index([vocabularyId])
  @@map("certification_topic_vocabularies")
}

/// Câu ví dụ cho từ vựng.
model VocabularyExample {
  id            String  @id @default(uuid()) @db.Uuid
  vocabularyId  String  @map("vocabulary_id") @db.Uuid
  sentenceEn    String  @map("sentence_en") @db.VarChar(500)
  translationVi String? @map("translation_vi") @db.VarChar(500)
  order         Int     @default(0)

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([vocabularyId])
  @@map("vocabulary_examples")
}

// =============================================================================
// CONTENT — Lessons, technical reading, case studies and certification review
// =============================================================================

model Lesson {
  id               String        @id @default(uuid()) @db.Uuid
  title            String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(220)
  summary          String        @db.VarChar(1000)
  type             LessonType
  domainId         String        @map("domain_id") @db.Uuid
  levelId          String        @map("level_id") @db.Uuid
  estimatedMinutes Int           @map("estimated_minutes")
  thumbnailUrl     String?       @map("thumbnail_url") @db.VarChar(2048)
  keyConcepts      String[]      @default([]) @map("key_concepts")
  status           ContentStatus @default(draft)
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)
  createdById      String        @map("created_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  domain       Domain              @relation(fields: [domainId], references: [id])
  level        Level               @relation(fields: [levelId], references: [id])
  createdBy    User                @relation("LessonCreatedBy", fields: [createdById], references: [id])
  sections     LessonSection[]
  vocabularies LessonVocabulary[]
  certificates LessonCertificate[]
  certificationTopics CertificationTopicLesson[]

  @@index([domainId])
  @@index([levelId])
  @@index([status])
  @@index([type])
  @@map("lessons")
}

model LessonSection {
  id       String            @id @default(uuid()) @db.Uuid
  lessonId String            @map("lesson_id") @db.Uuid
  type     LessonSectionType
  order    Int
  title    String?           @db.VarChar(200)
  content  Json

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("lesson_sections")
}

model LessonVocabulary {
  lessonId     String @map("lesson_id") @db.Uuid
  vocabularyId String @map("vocabulary_id") @db.Uuid

  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@id([lessonId, vocabularyId])
  @@map("lesson_vocabularies")
}

model CertificationTopicLesson {
  topicId  String @map("topic_id") @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid

  topic  CertificationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([topicId, lessonId])
  @@index([lessonId])
  @@map("certification_topic_lessons")
}

model LessonCertificate {
  lessonId      String @map("lesson_id") @db.Uuid
  certificateId String @map("certificate_id") @db.Uuid

  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([lessonId, certificateId])
  @@map("lesson_certificates")
}

// =============================================================================
// QUESTION BANK
// =============================================================================

/// Ngân hàng câu hỏi.
model Question {
  id              String        @id @default(uuid()) @db.Uuid
  type            QuestionType
  skill           QuestionSkill @default(vocabulary)
  prompt          String        @db.Text
  context         String?       @db.Text
  codeSnippet     String?       @map("code_snippet") @db.Text
  explanation     String        @db.Text
  domainId        String        @map("domain_id") @db.Uuid
  levelId         String        @map("level_id") @db.Uuid
  topics          String[]      @default([])
  acceptedAnswers String[]      @default([]) @map("accepted_answers")
  points          Float         @default(1.0)
  status          ContentStatus @default(draft)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  domain Domain @relation(fields: [domainId], references: [id])
  level  Level  @relation(fields: [levelId], references: [id])

  options             QuestionOption[]
  examQuestions       ExamQuestion[]
  certificationTopics CertificationTopicQuestion[]
  savedBy             SavedQuestion[]

  @@index([domainId])
  @@index([levelId])
  @@index([type])
  @@index([status])
  @@index([skill])
  @@map("questions")
}

model CertificationTopicQuestion {
  topicId    String @map("topic_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid

  topic    CertificationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([topicId, questionId])
  @@index([questionId])
  @@map("certification_topic_questions")
}

model SavedQuestion {
  learnerId  String   @map("learner_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  learner  User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([learnerId, questionId])
  @@index([questionId])
  @@map("saved_questions")
}

/// Các lựa chọn (options) cho câu hỏi.
model QuestionOption {
  id          String  @id @default(uuid()) @db.Uuid
  questionId  String  @map("question_id") @db.Uuid
  key         String  @db.VarChar(10)
  text        String  @db.Text
  isCorrect   Boolean @map("is_correct")
  explanation String? @db.Text
  order       Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

// =============================================================================
// EXAMS
// =============================================================================

/// Bài kiểm tra / đề thi.
model Exam {
  id                  String        @id @default(uuid()) @db.Uuid
  title               String        @db.VarChar(200)
  description         String        @db.VarChar(2000)
  domainId            String        @map("domain_id") @db.Uuid
  levelId             String        @map("level_id") @db.Uuid
  certificateId       String?       @map("certificate_id") @db.Uuid
  kind                ExamKind      @default(practice)
  topics              String[]      @default([])
  durationMinutes     Int           @map("duration_minutes")
  passingScorePercent Float         @default(70.0) @map("passing_score_percent")
  maxAttempts         Int           @default(1) @map("max_attempts")
  shuffleQuestions    Boolean       @default(false) @map("shuffle_questions")
  availableFrom       DateTime?     @map("available_from") @db.Timestamptz(6)
  availableUntil      DateTime?     @map("available_until") @db.Timestamptz(6)
  status              ContentStatus @default(draft)
  publishedAt         DateTime?     @map("published_at") @db.Timestamptz(6)
  createdById         String        @map("created_by_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  domain      Domain       @relation(fields: [domainId], references: [id])
  level       Level        @relation(fields: [levelId], references: [id])
  certificate Certificate? @relation(fields: [certificateId], references: [id])
  createdBy   User         @relation("ExamCreatedBy", fields: [createdById], references: [id])

  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([domainId])
  @@index([levelId])
  @@index([certificateId])
  @@index([status])
  @@index([certificateId, kind])
  @@map("exams")
}

/// Bảng nối Exam ↔ Question với thứ tự và trọng số.
model ExamQuestion {
  examId     String @map("exam_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  order      Int
  weight     Float  @default(1.0)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([examId, questionId])
  @@index([examId])
  @@map("exam_questions")
}

// =============================================================================
// ATTEMPTS
// =============================================================================

/// Lượt làm bài của học viên.
/// questions_snapshot lưu toàn bộ đề thi tại thời điểm bắt đầu (JSONB).
model ExamAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  examId            String        @map("exam_id") @db.Uuid
  learnerId         String        @map("learner_id") @db.Uuid
  status            AttemptStatus @default(in_progress)
  questionsSnapshot Json          @map("questions_snapshot")
  examSnapshot      Json          @map("exam_snapshot")
  score             Float?
  maxScore          Float?        @map("max_score")
  scorePercent      Float?        @map("score_percent")
  passed            Boolean?
  startedAt         DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(6)
  submittedAt       DateTime?     @map("submitted_at") @db.Timestamptz(6)
  gradedAt          DateTime?     @map("graded_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam    Exam @relation(fields: [examId], references: [id])
  learner User @relation(fields: [learnerId], references: [id])

  answers AttemptAnswer[]

  @@index([examId])
  @@index([learnerId])
  @@index([status])
  @@index([learnerId, examId])
  @@map("exam_attempts")
}

/// Câu trả lời của học viên trong một lượt làm bài.
model AttemptAnswer {
  id           String   @id @default(uuid()) @db.Uuid
  attemptId    String   @map("attempt_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  textAnswer   String?  @map("text_answer") @db.VarChar(2000)
  isCorrect    Boolean? @map("is_correct")
  earnedPoints Float?   @map("earned_points")
  maxPoints    Float    @map("max_points")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  selectedOptionIds String[] @default([]) @map("selected_option_ids") @db.Uuid

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("attempt_answers")
}

// =============================================================================
// PROGRESS
// =============================================================================

/// Tiến độ học tập của học viên theo Domain hoặc Certificate.
model LearningProgress {
  id                  String               @id @default(uuid()) @db.Uuid
  learnerId           String               @map("learner_id") @db.Uuid
  resourceType        ProgressResourceType @map("resource_type")
  resourceId          String               @map("resource_id") @db.Uuid
  completedLessonCount Int @default(0) @map("completed_lesson_count")
  totalLessonCount Int @default(0) @map("total_lesson_count")
  status              ProgressStatus       @default(not_started)
  completionPercent   Float                @default(0.0) @map("completion_percent")
  averageScorePercent Float?               @map("average_score_percent")
  startedAt           DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  learner User @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  /// resourceId points to a domain or certificate depending on resourceType.
  /// Referential integrity is checked in the application because PostgreSQL cannot attach
  /// two conditional foreign keys to the same polymorphic column.

  @@unique([learnerId, resourceType, resourceId])
  @@index([learnerId])
  @@index([resourceType, resourceId])
  @@map("learning_progress")
}

// =============================================================================
// VOCABULARY STUDY PROGRESS
// =============================================================================

/// Tiến độ học từ vựng của mỗi learner — SRS đơn giản.
model VocabularyProgress {
  id           String           @id @default(uuid()) @db.Uuid
  learnerId    String           @map("learner_id") @db.Uuid
  vocabularyId String           @map("vocabulary_id") @db.Uuid
  status       VocabStudyStatus @default(new)
  correctCount Int              @default(0) @map("correct_count")
  wrongCount   Int              @default(0) @map("wrong_count")
  lastReviewAt DateTime?        @map("last_review_at") @db.Timestamptz(6)
  nextReviewAt DateTime?        @map("next_review_at") @db.Timestamptz(6)
  lastRating   String?          @map("last_rating") @db.VarChar(20)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  learner    User       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([learnerId, vocabularyId])
  @@index([learnerId, status])
  @@index([learnerId, nextReviewAt])
  @@map("vocabulary_progress")
}

/// Private placement sessions, answer snapshots and saved personalized plans.
model PlacementAssessment {
  id          String    @id @default(uuid()) @db.Uuid
  learnerId   String    @map("learner_id") @db.Uuid
  questions   Json
  answers     Json?
  result      Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  learner User @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  @@index([learnerId, createdAt])
  @@map("placement_assessments")
}

/// Persistent reminders created by the server scheduler.
model LearningNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  localDate String    @map("local_date") @db.VarChar(10)
  title     String    @db.VarChar(150)
  body      String    @db.Text
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId, readAt, createdAt])
  @@map("learning_notifications")
}
