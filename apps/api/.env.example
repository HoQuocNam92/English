DATABASE_URL="postgresql://postgres:123456@localhost:5432/techenglish?schema=public"

JWT_SECRET=techenglish-super-secret-jwt-key-change-in-production-2026
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
API_PUBLIC_URL=http://localhost:8080
# Local: http://localhost:3000
# Production: public frontend URL, for example https://english-web-ca71.vercel.app
WEB_URL=http://localhost:3000
# Comma-separated list. Production must include the same public frontend URL as WEB_URL.
CORS_ORIGIN=http://localhost:3000,https://english-web-ca71.vercel.app

# Optional AI personalization. Falls back to rules when not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

SEPAY_API_KEY=placeholder
SEPAY_WEBHOOK_SECRET=placeholder

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin (gửi thông báo web/mobile từ máy chủ)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# SMTP Configuration (Nodemailer Email Service for Password Reset OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_app_password
SMTP_FROM="TechEnglish Pro" <no-reply@techenglish.pro>

APIVN_API_KEY=
APIVN_MODEL=gpt-6-luna
APIVN_BASE_URL=https://apivn.vn/v1

# Daily learning reminders: internal Nest cron or Windows/server scheduler
LEARNING_REMINDER_SCHEDULER=internal
# Required only for external scheduler; use a random secret >= 32 characters
LEARNING_REMINDER_JOB_KEY=
