{
  "name": "@techenglish/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test": "node --test -r ts-node/register src/application/learner-profile/study-time.spec.ts src/application/user/user.service.spec.ts src/application/auth/auth.service.spec.ts src/application/vocab-study/vocab-study.service.spec.ts src/infrastructure/ai/openai-recommendation.provider.spec.ts src/application/progress/progress.service.spec.ts src/application/vocabulary/vocabulary.service.spec.ts src/application/notification/notification.service.spec.ts src/application/quality/chapter5-regressions.spec.ts src/application/quality/chapter5-docker-fixes.spec.ts",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:aws": "ts-node prisma/seed-aws-clf-c02.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:seed:certification-lessons": "node --env-file=.env -r ts-node/register prisma/seed-certification-lessons.ts",
    "test:certification": "node -r ts-node/register src/application/lesson/certification-study.spec.ts",
    "db:seed:placement": "node --env-file=.env -r ts-node/register prisma/seed-placement.ts",
    "test:placement": "node --test -r ts-node/register src/application/placement/placement.service.spec.ts src/presentation/placement-test.controller.spec.ts",
    "test:agenda": "node -r ts-node/register src/application/progress/learning-agenda.service.spec.ts",
    "test:learning-path": "node --test -r ts-node/register src/application/progress/learning-path.service.spec.ts src/application/progress/continuation-plan.service.spec.ts && node --test prisma/seed-focused-curriculum.test.cjs",
    "test:learning-ai": "node -r ts-node/register src/infrastructure/ai/apivn-learning-planner.spec.ts",
    "test:bug-regressions": "node --test -r ts-node/register src/application/question/bug-regressions.spec.ts src/application/lesson/bulk-selection.spec.ts src/application/taxonomy/certificate-detail.spec.ts src/application/taxonomy/activity-days.spec.ts src/application/taxonomy/domain-options.spec.ts src/application/exam/question-scope.spec.ts src/application/exam/learner-exam.spec.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.2.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
