# Copy to .env.compose. Use URL-safe passwords (openssl rand -hex 24).
POSTGRES_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-random-hex-at-least-32-characters
API_PORT=8080
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:8080
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Physical phone: use your computer LAN IP in BOTH entries below.
MOBILE_LAN_HOST=192.168.1.10
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api/v1
# CD: pin both images to the same commit SHA.
# API_IMAGE=ghcr.io/hoquocnam92/english-api:COMMIT_SHA
# WEB_IMAGE=ghcr.io/hoquocnam92/english-web:COMMIT_SHA

# For compose.postgres.yml: use host.docker.internal instead of localhost
# when PostgreSQL is running on the Docker host. URL-encode credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/DATABASE?schema=public
