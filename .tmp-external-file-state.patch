+        for chunk in iter(lambda:stream.read(1024*1024),b''): h.update(chunk)
+    return h.hexdigest()
+def copy_to_db(db,dump):
+    remote='/tmp/techenglish-ops-'+uuid.uuid4().hex+'.dump'
